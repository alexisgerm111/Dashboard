<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard Directeur Commercial</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg:        #EEF1F6;
    --surface:   #FFFFFF;
    --surface-2: #F5F7FA;
    --border:    #E2E7EF;
    --border-2:  #D0D7E3;

    --blue:      #1D4ED8;
    --blue-light:#EFF4FF;
    --blue-mid:  #DBEAFE;

    --green:     #059669;
    --green-light:#ECFDF5;

    --amber:     #D97706;
    --amber-light:#FFFBEB;

    --red:       #DC2626;
    --red-light: #FEF2F2;

    --purple:    #7C3AED;
    --purple-light:#F5F3FF;

    --text-1:    #0F172A;
    --text-2:    #334155;
    --text-3:    #64748B;
    --text-4:    #94A3B8;

    --sidebar-w: 64px;
    --radius:    12px;
    --radius-sm: 8px;
    --shadow:    0 1px 3px rgba(15,23,42,0.06), 0 1px 2px rgba(15,23,42,0.04);
    --shadow-md: 0 4px 12px rgba(15,23,42,0.08), 0 2px 4px rgba(15,23,42,0.04);
  }

  html { font-size: 14px; }
  body {
    font-family: 'Inter', -apple-system, sans-serif;
    background: var(--bg);
    color: var(--text-1);
    display: flex;
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
  }

  /* ── SIDEBAR ────────────────────────────────────── */
  .sidebar {
    width: var(--sidebar-w);
    background: var(--text-1);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 18px 0 24px;
    position: fixed;
    top: 0; left: 0; bottom: 0;
    z-index: 100;
    gap: 4px;
  }
  .sidebar-logo {
    width: 32px; height: 32px;
    background: var(--blue);
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 24px;
    flex-shrink: 0;
  }
  .sidebar-logo svg { width: 18px; height: 18px; }
  .sb-icon {
    width: 40px; height: 40px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    transition: background 0.15s;
    color: #94A3B8;
  }
  .sb-icon:hover { background: rgba(255,255,255,0.08); color: #fff; }
  .sb-icon.active { background: rgba(29,78,216,0.3); color: #60A5FA; }
  .sb-icon svg { width: 18px; height: 18px; }
  .sidebar-divider { width: 24px; height: 1px; background: rgba(255,255,255,0.08); margin: 8px 0; }
  .sidebar-spacer { flex: 1; }
  .sb-avatar {
    width: 34px; height: 34px;
    border-radius: 50%;
    background: linear-gradient(135deg, #3B82F6, #1D4ED8);
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; font-weight: 600; color: #fff;
    cursor: pointer;
  }

  /* ── MAIN ────────────────────────────────────────── */
  .main {
    margin-left: var(--sidebar-w);
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* ── TOPBAR ──────────────────────────────────────── */
  .topbar {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 0 28px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky; top: 0;
    z-index: 50;
  }
  .topbar-left { display: flex; align-items: center; gap: 16px; }
  .topbar-title { font-size: 15px; font-weight: 600; color: var(--text-1); }
  .topbar-sub { font-size: 12px; color: var(--text-3); margin-top: 1px; }
  .topbar-right { display: flex; align-items: center; gap: 10px; }

  .period-tabs {
    display: flex;
    background: var(--bg);
    border-radius: var(--radius-sm);
    padding: 3px;
    gap: 2px;
  }
  .period-tab {
    padding: 5px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
    color: var(--text-3);
    cursor: pointer;
    border: none;
    background: transparent;
    transition: all 0.15s;
  }
  .period-tab.active {
    background: var(--surface);
    color: var(--text-1);
    box-shadow: var(--shadow);
  }

  .live-pill {
    display: flex; align-items: center; gap: 6px;
    background: var(--green-light);
    border: 1px solid #A7F3D0;
    border-radius: 20px;
    padding: 4px 10px 4px 8px;
    font-size: 11.5px;
    font-weight: 500;
    color: var(--green);
    cursor: pointer;
  }
  .live-dot {
    width: 7px; height: 7px;
    background: var(--green);
    border-radius: 50%;
    animation: pulse-green 2s infinite;
  }
  @keyframes pulse-green {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.85); }
  }

  .btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 7px 14px;
    border-radius: var(--radius-sm);
    font-size: 12.5px;
    font-weight: 500;
    cursor: pointer;
    border: none;
    transition: all 0.15s;
  }
  .btn-ghost {
    background: transparent;
    color: var(--text-2);
    border: 1px solid var(--border-2);
  }
  .btn-ghost:hover { background: var(--bg); }
  .btn-primary {
    background: var(--blue);
    color: white;
  }
  .btn-primary:hover { background: #1E40AF; }

  /* ── CONTENT ─────────────────────────────────────── */
  .content { padding: 24px 28px 48px; display: flex; flex-direction: column; gap: 20px; }

  /* ── AI FEED ─────────────────────────────────────── */
  .ai-feed {
    background: var(--surface);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    padding: 16px 20px;
    box-shadow: var(--shadow);
  }
  .ai-feed-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 14px;
  }
  .ai-feed-label {
    display: flex; align-items: center; gap: 8px;
    font-size: 11px; font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-3);
  }
  .ai-badge {
    background: linear-gradient(135deg, #1D4ED8, #7C3AED);
    color: white;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 4px;
    letter-spacing: 0.04em;
  }
  .feed-cards {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding-bottom: 4px;
    scrollbar-width: none;
  }
  .feed-cards::-webkit-scrollbar { display: none; }
  .feed-card {
    flex-shrink: 0;
    width: 320px;
    border-radius: 10px;
    padding: 14px 16px;
    border: 1px solid transparent;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .feed-card.type-opp { background: var(--green-light); border-color: #BBF7D0; }
  .feed-card.type-warn { background: var(--amber-light); border-color: #FDE68A; }
  .feed-card.type-alert { background: var(--red-light); border-color: #FECACA; }
  .feed-card.type-info { background: var(--blue-light); border-color: var(--blue-mid); }

  .feed-tag {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 10.5px; font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .feed-tag.opp { color: var(--green); }
  .feed-tag.warn { color: var(--amber); }
  .feed-tag.alert { color: var(--red); }
  .feed-tag.info { color: var(--blue); }

  .feed-text {
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--text-2);
  }
  .feed-text strong { color: var(--text-1); font-weight: 600; }
  .feed-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .feed-btn {
    font-size: 11.5px;
    font-weight: 500;
    padding: 5px 11px;
    border-radius: 6px;
    cursor: pointer;
    border: none;
    transition: all 0.15s;
  }
  .feed-btn.primary-action { background: var(--text-1); color: white; }
  .feed-btn.primary-action:hover { background: var(--blue); }
  .feed-btn.secondary-action { background: rgba(0,0,0,0.06); color: var(--text-2); }
  .feed-btn.secondary-action:hover { background: rgba(0,0,0,0.10); }

  /* ── ROI BLOCK ───────────────────────────────────── */
  .roi-block { display: flex; flex-direction: column; gap: 16px; }
  .roi-kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .roi-card {
    background: var(--surface);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    padding: 20px 22px;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    gap: 6px;
    position: relative;
    overflow: hidden;
  }
  .roi-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
  }
  .roi-card.accent-green::before { background: var(--green); }
  .roi-card.accent-blue::before { background: var(--blue); }
  .roi-card.accent-amber::before { background: var(--amber); }
  .roi-card.accent-purple::before { background: var(--purple); }

  .roi-label {
    font-size: 11px;
    font-weight: 500;
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .roi-value {
    font-size: 30px;
    font-weight: 700;
    color: var(--text-1);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .roi-value span.unit { font-size: 18px; font-weight: 600; }
  .roi-delta {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 12px;
    font-weight: 500;
    margin-top: 2px;
  }
  .roi-delta.up { color: var(--green); }
  .roi-delta.neutral { color: var(--amber); }
  .roi-sub { font-size: 11.5px; color: var(--text-3); line-height: 1.5; }
  .roi-cta {
    margin-top: 6px;
    font-size: 11.5px;
    font-weight: 500;
    color: var(--blue);
    cursor: pointer;
    text-decoration: none;
    display: inline-flex; align-items: center; gap: 4px;
  }
  .roi-cta:hover { text-decoration: underline; }

  /* ── CORRELATION CHART ───────────────────────────── */
  .correlation-card {
    background: var(--surface);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    padding: 22px 24px;
    box-shadow: var(--shadow);
  }
  .card-header {
    display: flex; align-items: flex-start; justify-content: space-between;
    margin-bottom: 20px;
  }
  .card-title { font-size: 14px; font-weight: 600; color: var(--text-1); }
  .card-sub { font-size: 12px; color: var(--text-3); margin-top: 2px; }

  .chart-legend {
    display: flex; gap: 16px; align-items: center;
  }
  .legend-item { display: flex; align-items: center; gap: 6px; font-size: 11.5px; color: var(--text-3); }
  .legend-dot { width: 8px; height: 8px; border-radius: 50%; }

  .chart-area {
    position: relative;
    height: 160px;
  }
  .chart-svg { width: 100%; height: 100%; overflow: visible; }

  /* ── GRID 2 COL ──────────────────────────────────── */
  .grid-2 { display: grid; grid-template-columns: 1fr 380px; gap: 16px; }
  .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; }

  /* ── TEAM MATRIX ─────────────────────────────────── */
  .team-card {
    background: var(--surface);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .team-card-header {
    padding: 18px 22px 14px;
    border-bottom: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between;
  }
  .filter-pills { display: flex; gap: 6px; }
  .filter-pill {
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11.5px;
    font-weight: 500;
    cursor: pointer;
    border: 1px solid var(--border-2);
    background: transparent;
    color: var(--text-3);
    transition: all 0.15s;
  }
  .filter-pill.active {
    background: var(--blue);
    color: white;
    border-color: var(--blue);
  }

  .team-table { width: 100%; border-collapse: collapse; }
  .team-table thead tr { background: var(--surface-2); }
  .team-table th {
    padding: 9px 16px;
    font-size: 10.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-3);
    text-align: left;
    border-bottom: 1px solid var(--border);
  }
  .team-table th:first-child { padding-left: 22px; }
  .team-table tbody tr {
    border-bottom: 1px solid var(--border);
    transition: background 0.12s;
    cursor: pointer;
  }
  .team-table tbody tr:hover { background: var(--surface-2); }
  .team-table tbody tr:last-child { border-bottom: none; }
  .team-table td { padding: 13px 16px; vertical-align: middle; }
  .team-table td:first-child { padding-left: 22px; }

  .rep-info { display: flex; align-items: center; gap: 11px; }
  .rep-avatar {
    width: 32px; height: 32px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; font-weight: 600;
    flex-shrink: 0;
  }
  .rep-name { font-size: 13px; font-weight: 500; color: var(--text-1); }
  .rep-role { font-size: 11px; color: var(--text-3); margin-top: 1px; }

  /* Circular progress - signature element */
  .circle-wrap {
    display: flex; align-items: center; gap: 10px;
  }
  .circ-svg { width: 40px; height: 40px; transform: rotate(-90deg); flex-shrink: 0; }
  .circ-bg { fill: none; stroke: var(--border); stroke-width: 3.5; }
  .circ-fill {
    fill: none;
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transition: stroke-dashoffset 1.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .circ-fill.green { stroke: var(--green); }
  .circ-fill.blue { stroke: var(--blue); }
  .circ-fill.amber { stroke: var(--amber); }
  .circ-fill.red { stroke: var(--red); }

  .circ-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-1);
  }

  .bar-mini {
    width: 100%;
    max-width: 120px;
    height: 5px;
    background: var(--border);
    border-radius: 3px;
    overflow: hidden;
  }
  .bar-mini-fill {
    height: 100%;
    border-radius: 3px;
    transition: width 1s ease;
  }
  .bar-mini-fill.blue { background: var(--blue); }
  .bar-mini-fill.green { background: var(--green); }
  .bar-mini-fill.amber { background: var(--amber); }

  .mini-stat { font-size: 12.5px; font-weight: 500; color: var(--text-2); margin-top: 4px; }

  .status-badge {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 3px 9px 3px 7px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 500;
  }
  .status-badge .dot { width: 5px; height: 5px; border-radius: 50%; }
  .badge-green { background: var(--green-light); color: var(--green); }
  .badge-green .dot { background: var(--green); }
  .badge-amber { background: var(--amber-light); color: var(--amber); }
  .badge-amber .dot { background: var(--amber); }
  .badge-red { background: var(--red-light); color: var(--red); }
  .badge-red .dot { background: var(--red); }
  .badge-purple { background: var(--purple-light); color: var(--purple); }
  .badge-purple .dot { background: var(--purple); }

  .action-link {
    font-size: 11.5px; font-weight: 500;
    color: var(--blue); cursor: pointer;
    background: none; border: none;
    padding: 0; display: inline-flex; align-items: center; gap: 3px;
  }
  .action-link:hover { text-decoration: underline; }

  /* ── RADAR ───────────────────────────────────────── */
  .radar-card {
    background: var(--surface);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    padding: 18px 20px;
  }
  .radar-filters { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 12px; }
  .radar-filter {
    padding: 3px 10px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 500;
    cursor: pointer;
    border: 1px solid var(--border-2);
    background: transparent;
    color: var(--text-3);
    transition: all 0.12s;
  }
  .radar-filter.active { background: var(--blue); color: white; border-color: var(--blue); }
  .radar-svg-wrap {
    display: flex;
    justify-content: center;
    margin: 16px 0 12px;
  }
  .radar-legend {
    display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;
  }
  .radar-leg-item { display: flex; align-items: center; gap: 5px; font-size: 11px; color: var(--text-3); }
  .radar-leg-line { width: 18px; height: 2.5px; border-radius: 2px; }

  /* ── RECRUITMENT ─────────────────────────────────── */
  .recruit-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 14px;
    margin-bottom: 16px;
  }
  .recruit-stat {
    background: var(--surface);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .recruit-stat-num { font-size: 28px; font-weight: 700; color: var(--text-1); letter-spacing: -0.02em; }
  .recruit-stat-label { font-size: 12px; color: var(--text-3); }
  .recruit-stat-impact { font-size: 11.5px; color: var(--green); font-weight: 500; margin-top: 4px; }

  .funnel-row {
    display: flex; flex-direction: column; gap: 6px;
    background: var(--surface);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    padding: 18px 22px;
    margin-bottom: 16px;
  }
  .funnel-step { display: flex; align-items: center; gap: 12px; }
  .funnel-label { font-size: 12px; color: var(--text-2); width: 200px; flex-shrink: 0; }
  .funnel-bar-bg { flex: 1; height: 8px; background: var(--bg); border-radius: 4px; overflow: hidden; }
  .funnel-bar-fill { height: 100%; border-radius: 4px; transition: width 1s ease; }
  .funnel-num { font-size: 12.5px; font-weight: 600; color: var(--text-1); width: 30px; text-align: right; }
  .funnel-pct { font-size: 11px; color: var(--text-3); width: 40px; }

  .ats-table-wrap {
    background: var(--surface);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .ats-table { width: 100%; border-collapse: collapse; }
  .ats-table th {
    padding: 9px 16px;
    font-size: 10.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-3);
    text-align: left;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }
  .ats-table th:first-child { padding-left: 22px; }
  .ats-table td { padding: 13px 16px; border-bottom: 1px solid var(--border); vertical-align: middle; }
  .ats-table td:first-child { padding-left: 22px; }
  .ats-table tbody tr:last-child td { border-bottom: none; }
  .ats-table tbody tr:hover { background: var(--surface-2); }

  .score-pill {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 3px 9px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
  }
  .score-high { background: var(--green-light); color: var(--green); }
  .score-mid { background: var(--amber-light); color: var(--amber); }
  .score-low { background: var(--red-light); color: var(--red); }

  .replay-btn {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--surface-2);
    border: 1px solid var(--border-2);
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 11.5px;
    font-weight: 500;
    color: var(--text-2);
    cursor: pointer;
    transition: all 0.15s;
  }
  .replay-btn:hover { background: var(--blue); color: white; border-color: var(--blue); }
  .play-icon { width: 12px; height: 12px; }

  /* ── COACHING ────────────────────────────────────── */
  .coaching-card {
    background: var(--surface);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .debrief-item {
    padding: 18px 22px;
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .debrief-item:last-child { border-bottom: none; }
  .debrief-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .debrief-meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .debrief-title { font-size: 13.5px; font-weight: 600; color: var(--text-1); }
  .deal-amount {
    font-size: 12px; font-weight: 600;
    background: var(--blue-light);
    color: var(--blue);
    padding: 2px 8px;
    border-radius: 5px;
  }
  .ai-badges { display: flex; gap: 6px; flex-wrap: wrap; }
  .ai-badge-item {
    font-size: 11px; font-weight: 500;
    padding: 3px 8px;
    border-radius: 5px;
